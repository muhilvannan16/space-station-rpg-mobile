# =============================================================================
# Space Station RPG – Kivy Layout
# =============================================================================

# --- Title Screen ---
<TitleScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 40
        spacing: 20
        canvas.before:
            Color:
                rgba: 0.05, 0.05, 0.12, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Widget:
            size_hint_y: 0.15

        Label:
            text: 'SPACE STATION RPG'
            font_size: '36sp'
            bold: True
            color: 0, 1, 1, 1
            size_hint_y: 0.15

        Label:
            text: 'Survive. Explore. Escape.'
            font_size: '16sp'
            color: 0.6, 0.6, 0.6, 1
            size_hint_y: 0.08

        Widget:
            size_hint_y: 0.1

        Button:
            text: 'Continue'
            font_size: '20sp'
            size_hint: 0.5, None
            height: 55
            pos_hint: {'center_x': 0.5}
            opacity: 1 if root.has_save else 0
            disabled: not root.has_save
            on_press: root.continue_game()

        Button:
            text: 'New Game'
            font_size: '20sp'
            size_hint: 0.5, None
            height: 55
            pos_hint: {'center_x': 0.5}
            on_press: root.new_game()

        Button:
            text: 'Tutorial'
            font_size: '20sp'
            size_hint: 0.5, None
            height: 55
            pos_hint: {'center_x': 0.5}
            on_press: root.start_tutorial()

        Widget:
            size_hint_y: 0.15

        Label:
            text: 'Arrow keys / D-pad: Move  |  Tap Save to save'
            font_size: '12sp'
            color: 0.5, 0.5, 0.5, 1
            size_hint_y: 0.05


# --- Game Screen ---
<GameScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0, 0, 0, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # HUD bar
        BoxLayout:
            size_hint_y: 0.07
            padding: 10, 0
            spacing: 10
            canvas.before:
                Color:
                    rgba: 0.1, 0.1, 0.15, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: f'O2: {root.oxygen}'
                font_size: '14sp'
                color: 0.3, 0.6, 1, 1
                bold: True
            Label:
                text: f'PWR: {root.power}'
                font_size: '14sp'
                color: 1, 1, 0, 1
                bold: True
            Label:
                text: f'HP: {root.health}'
                font_size: '14sp'
                color: 1, 0.3, 0.3, 1
                bold: True
            Button:
                text: 'Items'
                font_size: '12sp'
                size_hint_x: 0.25
                on_press: root.open_inventory()
            Button:
                text: 'Menu'
                font_size: '12sp'
                size_hint_x: 0.25
                on_press: root.open_menu()

        # Map container
        BoxLayout:
            id: map_container
            size_hint_y: 0.58

        # Message area
        Label:
            size_hint_y: 0.07
            text: root.message
            font_size: '13sp'
            color: 1, 1, 1, 1
            canvas.before:
                Color:
                    rgba: 0.08, 0.08, 0.12, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

        # D-pad controls
        BoxLayout:
            size_hint_y: 0.28
            orientation: 'vertical'
            padding: 10
            spacing: 5
            canvas.before:
                Color:
                    rgba: 0.06, 0.06, 0.1, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            # Up row
            BoxLayout:
                Widget:
                Button:
                    text: '^'
                    font_size: '24sp'
                    size_hint_x: 0.33
                    on_press: root.move_player(0, -1)
                Widget:

            # Middle row: Left, blank, Right
            BoxLayout:
                Button:
                    text: '<'
                    font_size: '24sp'
                    on_press: root.move_player(-1, 0)
                Widget:
                    size_hint_x: 0.33
                Button:
                    text: '>'
                    font_size: '24sp'
                    on_press: root.move_player(1, 0)

            # Down row
            BoxLayout:
                Widget:
                Button:
                    text: 'v'
                    font_size: '24sp'
                    size_hint_x: 0.33
                    on_press: root.move_player(0, 1)
                Widget:


# --- Combat Screen ---
<CombatScreen>:
    FloatLayout:
        size_hint: 1, 1

        BoxLayout:
            orientation: 'vertical'
            padding: 30
            spacing: 15
            size_hint: 1, 1
            canvas.before:
                Color:
                    rgba: 0.1, 0.02, 0.02, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: f'⚔  {root.enemy_name}'
                font_size: '28sp'
                bold: True
                color: 1, 0.3, 0.3, 1
                size_hint_y: 0.12

            BoxLayout:
                size_hint_y: 0.12
                spacing: 20
                Label:
                    id: player_hp_label
                    text: f'Your HP: {root.player_hp}'
                    font_size: '18sp'
                    color: 0, 1, 1, 1
                Label:
                    id: enemy_hp_label
                    text: f'Enemy HP: {root.enemy_hp}'
                    font_size: '18sp'
                    color: 1, 0.4, 0.4, 1

            Label:
                text: root.message
                font_size: '14sp'
                color: 1, 1, 1, 1
                size_hint_y: 0.15
                text_size: self.size
                halign: 'center'
                valign: 'middle'

            Widget:
                size_hint_y: 0.2

            Button:
                text: f'Attack (dmg: {root.weapon_damage})'
                font_size: '18sp'
                size_hint: 0.7, None
                height: 55
                pos_hint: {'center_x': 0.5}
                on_press: root.attack()

            Button:
                text: 'Run Away'
                font_size: '18sp'
                size_hint: 0.7, None
                height: 55
                pos_hint: {'center_x': 0.5}
                on_press: root.run_away()

        FloatLayout:
            id: fx_layer
            size_hint: 1, 1

        Widget:
            size_hint_y: 0.15


# --- Hazard Event Screen ---
<EventScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 30
        spacing: 15
        canvas.before:
            Color:
                rgba: 0.12, 0.08, 0.0, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: '⚠  HAZARD!'
            font_size: '28sp'
            bold: True
            color: 1, 0.8, 0, 1
            size_hint_y: 0.1

        Label:
            text: root.description
            font_size: '15sp'
            color: 1, 1, 1, 1
            size_hint_y: 0.3
            text_size: self.size
            halign: 'center'
            valign: 'middle'

        BoxLayout:
            id: choice_buttons
            orientation: 'vertical'
            spacing: 10
            size_hint_y: 0.4

        Widget:
            size_hint_y: 0.2


# --- End Screen ---
<EndScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 40
        spacing: 20
        canvas.before:
            Color:
                rgba: 0.05, 0.05, 0.12, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Widget:
            size_hint_y: 0.25

        Label:
            text: root.result
            font_size: '24sp'
            bold: True
            color: 1, 1, 1, 1
            size_hint_y: 0.2
            text_size: self.size
            halign: 'center'
            valign: 'middle'

        Widget:
            size_hint_y: 0.15

        Button:
            text: 'Back to Title'
            font_size: '20sp'
            size_hint: 0.5, None
            height: 55
            pos_hint: {'center_x': 0.5}
            on_press: root.manager.current = 'title'

        Widget:
            size_hint_y: 0.3


# --- Inventory Popup ---
<InventoryPopup>:
    title: 'Inventory'
    title_color: 0, 1, 1, 1
    title_size: '18sp'
    size_hint: 0.85, 0.7
    separator_color: 0, 1, 1, 1
    background_color: 0.08, 0.08, 0.15, 1

    BoxLayout:
        orientation: 'vertical'
        spacing: 10
        padding: 10

        ScrollView:
            size_hint_y: 0.85
            BoxLayout:
                id: item_list
                orientation: 'vertical'
                spacing: 8
                size_hint_y: None
                height: self.minimum_height

        Button:
            text: 'Close'
            font_size: '16sp'
            size_hint_y: None
            height: 45
            on_press: root.dismiss()


# --- Menu Popup ---
<MenuPopup>:
    title: 'Menu'
    title_color: 0, 1, 1, 1
    title_size: '18sp'
    size_hint: 0.75, 0.5
    separator_color: 0, 1, 1, 1
    background_color: 0.08, 0.08, 0.15, 1

    BoxLayout:
        orientation: 'vertical'
        spacing: 12
        padding: 15
        Button:
            id: save_btn
            text: 'Save'
            font_size: '14sp'
        Button:
            id: exit_btn
            text: 'Exit to Menu'
            font_size: '14sp'
        Button:
            id: cancel_btn
            text: 'Cancel'
            font_size: '14sp'


# --- Tutorial Screen ---
<TutorialScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0, 0, 0, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # Instruction banner + Skip button
        BoxLayout:
            size_hint_y: 0.09
            padding: 10, 0
            spacing: 10
            canvas.before:
                Color:
                    rgba: 0.08, 0.15, 0.08, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: root.instruction
                font_size: '13sp'
                color: 0.2, 1, 0.4, 1
                bold: True
                text_size: self.size
                halign: 'left'
                valign: 'middle'
            Button:
                text: 'Items'
                font_size: '12sp'
                size_hint_x: 0.15
                on_press: root.open_inventory()
            Button:
                text: 'Skip'
                font_size: '12sp'
                size_hint_x: 0.15
                on_press: root.skip_tutorial()

        # Map container
        BoxLayout:
            id: tut_map_container
            size_hint_y: 0.58

        # Message area
        Label:
            size_hint_y: 0.07
            text: root.message
            font_size: '13sp'
            color: 1, 1, 1, 1
            canvas.before:
                Color:
                    rgba: 0.08, 0.08, 0.12, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

        # D-pad controls
        BoxLayout:
            size_hint_y: 0.26
            orientation: 'vertical'
            padding: 10
            spacing: 5
            canvas.before:
                Color:
                    rgba: 0.06, 0.06, 0.1, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            BoxLayout:
                Widget:
                Button:
                    text: '^'
                    font_size: '24sp'
                    size_hint_x: 0.33
                    on_press: root.move_player(0, -1)
                Widget:

            BoxLayout:
                Button:
                    text: '<'
                    font_size: '24sp'
                    on_press: root.move_player(-1, 0)
                Widget:
                    size_hint_x: 0.33
                Button:
                    text: '>'
                    font_size: '24sp'
                    on_press: root.move_player(1, 0)

            BoxLayout:
                Widget:
                Button:
                    text: 'v'
                    font_size: '24sp'
                    size_hint_x: 0.33
                    on_press: root.move_player(0, 1)
                Widget:
